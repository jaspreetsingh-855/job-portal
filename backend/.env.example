PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string

# Local MongoDB (persistent on your PC):
MONGO_URI=mongodb://127.0.0.1:27017/jobportal

# Or MongoDB Atlas (cloud) — replace with your connection string:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/jobportal?retryWrites=true&w=majority
