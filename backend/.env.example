PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173

# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/jobportal

# Or MongoDB Atlas
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/jobportal?retryWrites=true&w=majority

# Optional: emails when employer changes application status
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youremail@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Job Portal <youremail@gmail.com>
